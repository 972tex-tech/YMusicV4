{
  "compilerOptions": {
    // Injected script runs in a real browser/WebView against YouTube's own player — DOM libs,
    // BigInt for protobuf. Kept at the source project's strictness (strict, not engine-js's
    // static-analysis discipline): this code reflects over YouTube internals by design.
    "target": "es2016",
    "lib": ["ES6", "DOM", "DOM.Iterable", "ES2020.BigInt"],
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
