<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The JVM compiles bytecode at runtime, and Chromium (JCEF) JITs JavaScript: under a
         hardened runtime both need executable memory the loader did not sign. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- CEF is downloaded on first run (~150MB, jcefmaven) and is therefore not covered by our
         signature. A hardened runtime refuses unsigned dylibs unless library validation is off.
         REMOVE THIS once CEF ships inside the signed bundle — it is the one entitlement here that
         genuinely weakens the process. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- QuickJS's JNI library is extracted to a temp file and loaded from there. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
