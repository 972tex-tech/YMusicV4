<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- In-app updates: the downloaded APK is handed to PackageInstaller. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Android 11+ package visibility: premium is "the Support Development app is installed", and
         Donate starts its donation screen. -->
    <queries>
        <package android:name="com.kdev.ymusic.support" />
    </queries>

    <application
        android:name=".YMusicApplication"
        android:allowBackup="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YMusicV4">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:theme="@style/Theme.YMusicV4">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QrScanActivity"
            android:exported="false"
            android:theme="@style/Theme.YMusicV4" />

        <!-- Queue/browse artwork for Android Auto & co: exported because the car host holds no
             permission of ours; openFile validates every target (see ArtworkProvider). -->
        <provider
            android:name=".ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true" />

        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- Legacy interface Android Auto binds to; media3 serves it from the same session. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Foreground standing while the download queue runs; exits when the queue drains. -->
        <service
            android:name=".DownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Declares the app to the Android Auto host as a media app. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false" />
    </application>

</manifest>
